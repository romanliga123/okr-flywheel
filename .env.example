# ── OKR Agent — настройки веб-сервера ──────────────────────────────
# Скопируйте этот файл в .env и заполните значения

# Провайдер LLM: claude | gemini | groq | mistral | kimi | ollama
OKR_PROVIDER=gemini

# API-ключ выбранного провайдера
OKR_API_KEY=ваш_ключ_здесь

# Язык распознавания речи
OKR_LANGUAGE=ru-RU

# Пароль доступа к веб-версии (оставьте пустым — без пароля)
OKR_PASSWORD=

# Только для Ollama — название модели
OKR_OLLAMA_MODEL=neural-chat
